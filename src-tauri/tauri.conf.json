{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mantle",
  "version": "0.1.0",
  "identifier": "dev.mantle.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": false,
    "icon": []
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "bar",
        "title": "",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "width": 1920,
        "height": 32,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
