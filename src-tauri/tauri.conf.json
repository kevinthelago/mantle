{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mantle",
  "version": "0.1.0",
  "identifier": "dev.mantle",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "bar",
        "url": "index.html",
        "width": 1920,
        "height": 36,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "notifications",
        "title": "",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "width": 420,
        "height": 1080,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "launcher",
        "title": "",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "width": 640,
        "height": 480,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "widgets",
        "title": "",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "width": 400,
        "height": 800,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
